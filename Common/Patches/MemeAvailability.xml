<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-driven meme gates for Ideology Reformation.

  A gate is attached to each MemeDef through MemeAvailabilityExtension. To
  rebalance an unlock, edit only this file; no C# rebuild is required.

  Supported fields:
    minTechLevel     The colony's effective tech level must be at least this.
    requiredResearch Every listed ResearchProjectDef must be finished.
    requiredResearchDefNames
                     Every project named here must be finished. Use this for
                     research defs generated after XML cross-reference resolution.

  Any field can be used alone. When several are present, every requirement
  must be met. Other mods can use the same extension on their own MemeDefs.
-->
<Patch>

  <!-- Beliefs that do not depend on a particular invention. Keeping an
       explicit Neolithic floor makes every vanilla meme data-controlled while
       preserving a useful set of tribal and starting beliefs. -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AnimalPersonhood"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><minTechLevel>Neolithic</minTechLevel></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="Blindsight"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><minTechLevel>Neolithic</minTechLevel></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="Cannibal"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><minTechLevel>Neolithic</minTechLevel></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="Collectivist"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><minTechLevel>Neolithic</minTechLevel></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="FemaleSupremacy"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><minTechLevel>Neolithic</minTechLevel></li></value>
  </Operation>
