<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-driven meme gates for Ideology Reformation.

  A gate is attached to each MemeDef through MemeAvailabilityExtension. To
  rebalance an unlock, edit only this file; no C# rebuild is required.

  Supported fields:
    requiredResearch Every listed ResearchProjectDef must be finished.
    requiredResearchDefNames
                     Every project named here must be finished. Use this for
                     research defs generated after XML cross-reference resolution.

  Any field can be used alone. When several are present, every requirement
  must be met. Other mods can use the same extension on their own MemeDefs.
-->
<Patch>

  <!-- Research-driven beliefs. -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="HighLife"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>PsychoidBrewing</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="TreeConnection"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>TreeSowing</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="Tunneler"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Stonecutting</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="Darkness"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Electricity</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="HumanPrimacy"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Machining</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="FleshPurity"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Prosthetics</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="Transhumanist"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Biosculpting</li></requiredResearch></li></value>
  </Operation>

  <!-- Expansion memes. MayRequire prevents missing-DLC patch errors. -->

  <Operation Class="PatchOperationAddModExtension" MayRequire="Ludeon.RimWorld.Biotech">
    <xpath>Defs/MemeDef[defName="Bloodfeeding"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Deathrest</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension" MayRequire="Ludeon.RimWorld.Anomaly">
    <xpath>Defs/MemeDef[defName="Ritualist"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>BasicPsychicRituals</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension" MayRequire="Ludeon.RimWorld.Anomaly">
    <xpath>Defs/MemeDef[defName="Inhuman"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>AdvancedPsychicRituals</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/MemeDef[defName="Shipborn"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>OrbitalTech</li></requiredResearch></li></value>
  </Operation>

</Patch>
