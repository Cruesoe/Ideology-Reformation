<?xml version="1.0" encoding="utf-8"?>
<!--
  Curated research gates for Alpha Memes 1.6.

  Only beliefs with a direct technological dependency are gated. Cultural,
  ethical and spiritual Alpha Memes remain unrestricted. Gates that need
  Biotech or Progression: Agriculture are in Mods/AlphaMemesBiotech and
  Mods/AlphaMemesProgressionAgriculture.
-->
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_GauranlenSupremacy" or defName="AM_BiologicalCorruptors"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>TreeSowing</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_BiologicalReconstructors"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>MedicineProduction</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_Bulwark"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Smithing</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_Sharpshooter"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Gunsmithing</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_Gladiator"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>LongBlades</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_DeepDevotion"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Stonecutting</li></requiredResearch></li></value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/MemeDef[defName="AM_WaterPrimacy"]</xpath>
    <value><li Class="IdeologyReformation.Restrictions.MemeAvailabilityExtension"><requiredResearch><li>Hydroponics</li></requiredResearch></li></value>
  </Operation>
</Patch>
